# --- LLM (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-3.5-flash-lite

# --- Telegram (free: message @BotFather, send /newbot, paste the token) ---
TELEGRAM_BOT_TOKEN=
# "telegram" talks to real patients; "console" just prints (local dev / demo CLI)
CHANNEL=telegram

# --- Database ---
# Local file (default):
DATABASE_URL=sqlite:///./hermod.db
# Supabase: Project -> Connect -> "Session pooler" URI (port 5432), with your DB password:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- App ---
TIMEZONE=Australia/Sydney
# Optional: n8n webhook that receives doctor alerts (email/Slack fan-out)
N8N_ALERT_WEBHOOK_URL=

# --- Dashboard API ---
# Optional shared key: if set, every /api request needs header "X-API-Key: <key>"
API_KEY=
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
