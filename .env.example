# --- LLM (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-3.5-flash-lite

# --- Telegram (free: message @BotFather, send /newbot, paste the token) ---
TELEGRAM_BOT_TOKEN=
# "telegram" talks to real patients; "console" just prints (local dev / demo CLI)
CHANNEL=telegram

# --- App ---
DATABASE_URL=sqlite:///./hermod.db
TIMEZONE=Australia/Sydney
# Optional: n8n webhook that receives doctor alerts (email/Slack fan-out)
N8N_ALERT_WEBHOOK_URL=
