# --- LLM (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-2.5-flash

# --- WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
# Pre-approved utility template used for proactive check-ins outside the 24h window
WHATSAPP_CHECKIN_TEMPLATE=hello_world

# --- App ---
DATABASE_URL=sqlite:///./hermod.db
TIMEZONE=Australia/Sydney
# Optional: n8n webhook that receives doctor alerts (email/Slack fan-out)
N8N_ALERT_WEBHOOK_URL=
